# Node
**/node_modules/

# Yarn
**/yarn-debug.log*
**/yarn-error.log*
**/.yarn-integrity

# NYC
**/.nyc_output
**/coverage/

# WebStorm (https://www.jetbrains.com/help/idea/managing-projects-under-version-control.html)
**/.idea/workspace.xml
**/.idea/tasks.xml

# Compiled source
**/src/**/*.js
**/src/**/*.map
**/test/**/*.js
**/test/**/*.map
**/html/**/*.js
**/html/**/*.map
**/bin/

# AutoTest run/queue state; created wherever a process is launched from when
# PERSIST_DIR is a relative path (as it is for local development). The previous
# rule (persist/queues/**.json) was anchored here and only covered the queue JSON.
persist/

packages/common/**/*.js
packages/common/**/*.map
packages/portal/backend/**/*.js
packages/portal/backend/**/*.map
packages/portal/frontend/**/*.js
packages/portal/frontend/**/*.map

# webpack's CopyPlugin writes the active plugin's html into html/<NAME>, where NAME comes
# from .env, so the directory name differs per fork. Only files at the root of html/ are
# tracked; every subdirectory (including html/js/) is build output.
packages/portal/frontend/html/*/

## Fork-specific resources
packages/portal/backend/test/cs310/
packages/portal/frontend/html/cs310/
packages/portal/frontend/src/app/custom/CustomAdminView.ts
packages/portal/frontend/src/app/custom/CustomStudentView.ts
packages/portal/backend/src/custom/CustomCourseController.ts
packages/portal/backend/src/custom/CustomCourseRoutes.ts

# Plugins
packages/portal/frontend/src/app/plugs/

.circleci/

# Webstorm
**/.idea

# Visual Studio
.vscode/

# MacOS
**/.DS_Store

# Env
**/.env
**/.env*

# Misc
/data/
.rsyncexclude
testOutput/
packages/autotest/testOutput/
packages/autotest/test/data/

# SSL
ssl/
ssl.log

# Excludes plugins aside default plugin
plugins/*
!plugins/default/
plugins/default/**/*.js
plugins/default/**/*.js.map
!plugins/example/
plugins/example/**/*.js
plugins/example/**/*.js.map
docker-compose.override.yml
packages/proxy/nginx.rconf
