{
    "compilerOptions": {
        "module": "commonjs",
        "target": "ES6",
        "noImplicitAny": true,
        "removeComments": true,
        "preserveConstEnums": true,
        "sourceMap": true,
        // TypeScript 7 removed 'baseUrl' and requires path mappings to be relative to
        // this file. 'strict' is pinned off to preserve the pre-7 semantics; TS 7 turns it
        // on by default, which surfaces ~1250 additional null/undefined diagnostics.
        // TODO: think about turning strict on later (this would be a large diff, so skipped for now)
        "strict": false,
        "paths": {
            "@common/*": [
                "./packages/common/src/*",
                "./packages/common/test/*"
            ],
            "@frontend/*": [
                "./packages/portal/frontend/src/app/*"
            ],
            "@backend/*": [
                "./packages/portal/backend/src/*"
            ],
            "@autotest/*": [
                "./packages/autotest/src/*"
            ]
        },
        "lib": [
            "es7",
            "es2017.object",
            "es2018.AsyncIterable",
            "dom"
        ],
        "typeRoots": [
            "./node_modules/@types"
        ]
    },
    "exclude": [
        "node_modules"
]
}
