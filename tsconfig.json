{
    "compilerOptions": {
        "module": "commonjs",
        "target": "ES6",
        "noImplicitAny": true,
        "removeComments": true,
        "preserveConstEnums": true,
        "sourceMap": true,
        // TypeScript 7 removed 'baseUrl' and requires path mappings to be relative to
        // this file. 'strict' is pinned off to preserve the pre-7 semantics; TS 7 turns it
        // on by default, which surfaces ~1250 additional null/undefined diagnostics.
        // TODO: think about turning strict on later (this would be a large diff, so skipped for now)
        "strict": false,
        "paths": {
            "@common/*": [
                "./packages/common/src/*",
                "./packages/common/test/*"
            ],
            "@frontend/*": [
                "./packages/portal/frontend/src/app/*"
            ],
            "@backend/*": [
                "./packages/portal/backend/src/*"
            ],
            "@autotest/*": [
                "./packages/autotest/src/*"
            ]
        },
        "lib": [
            "es7",
            "es2017.object",
            "es2018.AsyncIterable",
            "dom"
        ],
        "typeRoots": [
            "./node_modules/@types"
        ]
    },
    // Without an explicit "include", tsc globs every .ts under the repo root -- which means
    // any course plugin checked out into plugins/ (a gitignored, separately-owned repo) can
    // break Classy's build. Course plugins are free to keep their own self-contained
    // TypeScript projects outside portal/: plugins/cs310/scripts, for one, has its own
    // tsconfig.json, package.json, and typescript, and is built from inside that directory.
    //
    // plugins/*/portal is the plugin contract surface and MUST stay here: packages/portal's
    // Dockerfile relies on this compile to emit the plugin's .js for webpack and the backend.
    // The glob also keeps the shipped default and example plugins type-checked.
    "include": [
        "packages/**/*.ts",
        "plugins/*/portal/**/*.ts"
    ],
    "exclude": [
        // "node_modules" alone is anchored here and would miss packages/*/node_modules;
        // those are empty under yarn workspaces today, but not by guarantee.
        "**/node_modules"
]
}
