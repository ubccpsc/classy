{
    "private": true,
    "name": "classy",
    "description": "A GitHub service for grading commits and posting feedback.",
    "homepage": "https://github.com/ubccpsc/classy",
    "author": {
        "name": "Reid Holmes",
        "url": "https://cs.ubc.ca/~rtholmes"
    },
    "contributors": [
        {
            "name": "Nick Bradley",
            "email": "nick@ncbradley.com",
            "url": "https://www.ncbradley.com"
        }
    ],
    "license": "MIT",
    "version": "1.4.0",
    "engines": {
        "node": ">= 22.0.0 < 24"
    },
    "workspaces": [
        "packages/*",
        "packages/portal/frontend",
        "packages/portal/backend"
    ],
    "dependencies": {
        "dotenv": "^17.4.2",
        "fs-extra": "5.0.0",
        "jszip": "3.8.0",
        "mongodb": "^4.17.0",
        "node-fetch": "^2.6.7",
        "restify": "^10.0.0"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.5",
        "@types/bson": "^4.2.0",
        "@types/fs-extra": "5.0.0",
        "@types/jszip": "3.1.6",
        "@types/mocha": "^9.1.1",
        "@types/node": "^20.19.43",
        "@types/node-fetch": "^2.5.5",
        "@types/restify": "8.5.5",
        "chai": "^4.3.6",
        "jsonschema": "1.2.2",
        "mocha": "^9.2.2",
        "typescript": "^7.0.2",
        "webpack": "^5.94.0"
    },
    "resolutions": {
        "**/mem": "^4.0.0"
    },
    "nyc": {
        "exclude": [
            "**/*Spec.ts",
            "**/TestHarness.ts",
            "**/TestData.ts",
            "**/TestGitHubActions.ts"
        ]
    },
    "scripts": {
        "postinstall": "git config core.hooksPath .githooks",
        "build": "tsc",
        "build:prod": "tsc --outDir bin --sourceMap false",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "cover": "TS_NODE_BASEURL=. nyc --reporter text --reporter html --report-dir ./testOutput/coverage yarn run test",
        "test": "TS_NODE_BASEURL=. mocha --require=dotenv/config --require tsconfig-paths/register --timeout 10000 --recursive --exit packages/portal/backend/test packages/autotest/test",
        "test:backend": "TS_NODE_BASEURL=. mocha --require=dotenv/config --require tsconfig-paths/register --timeout 10000 --recursive --exit packages/portal/backend/test",
        "test:autotest": "TS_NODE_BASEURL=. mocha --require=dotenv/config --require tsconfig-paths/register --timeout 10000 --recursive --exit packages/autotest/test"
    }
}
