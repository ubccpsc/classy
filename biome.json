{
	"$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["packages/**/src*/**/*.ts", "packages/**/test/**/*.ts"],
		"ignoreUnknown": true
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 140,
		"lineEnding": "lf"
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "es5",
			"arrowParentheses": "always"
		},
		"globals": ["$", "_"]
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "none",
			"complexity": {
				"noExcessiveLinesPerFunction": {
					"level": "info",
					"options": {
						"maxLines": 120,
						"skipBlankLines": true,
						"skipIifes": false
					}
				},
				"useLiteralKeys": "warn",
				"useOptionalChain": "error"
			},
			"correctness": {
				"noUnusedVariables": "error"
			},
			"security": {
				"noGlobalEval": "error"
			},
			"style": {
				"noExcessiveLinesPerFile": {
					"level": "info",
					"options": {
						"maxLines": 1000,
						"skipBlankLines": true
					}
				},
				"useConsistentMemberAccessibility": {
					"level": "error",
					"options": {
						"accessibility": "explicit"
					}
				},
				"useConst": "error",
				"useForOf": "error",
				"useFilenamingConvention": {
					"level": "error",
					"options": {
						"strictCase": false,
						"filenameCases": ["camelCase", "PascalCase"]
					}
				}
			},
			"suspicious": {
				"noAsyncPromiseExecutor": "error",
				"noConfusingVoidType": "error",
				"noConsole": "error",
				"noDoubleEquals": "error",
				"noShadow": "error",
				"noVar": "error"
			},
			"nursery": {
				"noExcessiveNestedCallbacks": {
					"level": "error",
					"options": {
						"max": 5
					}
				},
				"noIdenticalTestTitle": "error",
				"noImpliedEval": "error",
				"noMisusedPromises": "error"
			}
		}
	},
	"overrides": [
		{
			"includes": ["packages/**/test/**/*.ts"],
			"linter": {
				"rules": {
					"complexity": {
						"noExcessiveLinesPerFunction": "off"
					}
				}
			}
		}
	]
}
